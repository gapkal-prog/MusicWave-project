{
  "name": "manacore/musicwave",
  "description": "Development tooling for the MusicWave WordPress theme and companion plugins.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.6",
    "phpstan/phpstan": "^1.12 || ^2.1",
    "phpcompatibility/php-compatibility": "^9.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "check:syntax": [
      "@php -l music-wave-core/music-wave-core.php",
      "@php -l music-wave-core/index.php",
      "@php -l music-wave-core/src/Contracts/Module.php",
      "@php -l music-wave-core/src/Contracts/Migration.php",
      "@php -l music-wave-core/src/Contracts/ReleaseRepository.php",
      "@php -l music-wave-core/src/Admin/ProductReleasePanel.php",
      "@php -l music-wave-core/src/Admin/ReleaseMetaBox.php",
      "@php -l music-wave-core/src/Admin/CollectionCandidateRoutes.php",
      "@php -l music-wave-core/src/Admin/ReleaseReadiness.php",
      "@php -l music-wave-core/src/Admin/EditorAssets.php",
      "@php -l music-wave-core/src/Admin/DiagnosticsPage.php",
      "@php -l music-wave-core/src/Admin/BulkAccessManager.php",
      "@php -l music-wave-core/src/Admin/SettingsPage.php",
      "@php -l music-wave-core/src/Access/AccessDecision.php",
      "@php -l music-wave-core/src/Access/AccessPolicyEngine.php",
      "@php -l music-wave-core/src/Access/AccessSubject.php",
      "@php -l music-wave-core/src/Access/ManualAccessProvider.php",
      "@php -l music-wave-core/src/Access/MembershipProvider.php",
      "@php -l music-wave-core/src/Access/NullManualAccessProvider.php",
      "@php -l music-wave-core/src/Access/NullMembershipProvider.php",
      "@php -l music-wave-core/src/Blocks/ReleaseBlocks.php",
      "@php -l music-wave-core/src/Blocks/BlockSupport.php",
      "@php -l music-wave-core/src/Blocks/BlockMetadata.php",
      "@php -l music-wave-core/src/Blocks/ArtistProfileBlock.php",
      "@php -l music-wave-core/src/Blocks/LibraryBlocks.php",
      "@php -l music-wave-core/src/Blocks/PreviewPlayer.php",
      "@php -l music-wave-core/src/Catalog/ReleasePostType.php",
      "@php -l music-wave-core/src/Catalog/ReleaseTaxonomies.php",
      "@php -l music-wave-core/src/Catalog/ReleaseArchiveQuery.php",
      "@php -l music-wave-core/src/Catalog/ReleaseDefaults.php",
      "@php -l music-wave-core/src/Catalog/ArtistTermMeta.php",
      "@php -l music-wave-core/src/Catalog/DemoContentImporter.php",
      "@php -l music-wave-core/src/Commerce/ProductMapper.php",
      "@php -l music-wave-core/src/Commerce/PurchaseChecker.php",
      "@php -l music-wave-core/src/Commerce/AccountLibrary.php",

      "@php -l music-wave-core/src/Downloads/DownloadProvider.php",
      "@php -l music-wave-core/src/Downloads/StreamableDownloadProvider.php",
      "@php -l music-wave-core/src/Downloads/DownloadResolver.php",
      "@php -l music-wave-core/src/Downloads/DownloadRoutes.php",
      "@php -l music-wave-core/src/Downloads/DownloadAssetRoutes.php",
      "@php -l music-wave-core/src/Downloads/DownloadTokenClaims.php",
      "@php -l music-wave-core/src/Downloads/DownloadTokenService.php",
      "@php -l music-wave-core/src/Downloads/NullDownloadProvider.php",
      "@php -l music-wave-core/src/Downloads/ReplayStore.php",
      "@php -l music-wave-core/src/Downloads/TransientReplayStore.php",

      "@php -l music-wave-core/src/Infrastructure/CollectionRestPolicy.php",
      "@php -l music-wave-core/src/Infrastructure/WordPressReleaseRepository.php",
      "@php -l music-wave-core/src/Library/LibraryRepository.php",
      "@php -l music-wave-core/src/Library/LibraryCatalog.php",
      "@php -l music-wave-core/src/Library/LibraryButton.php",
      "@php -l music-wave-core/src/Library/LibraryRoutes.php",
      "@php -l music-wave-core/src/Lifecycle/Activator.php",
      "@php -l music-wave-core/src/Lifecycle/Deactivator.php",
      "@php -l music-wave-core/src/Migrations/MigrationRunner.php",
      "@php -l music-wave-core/src/Migrations/Schema020.php",
      "@php -l music-wave-core/src/Migrations/Schema030.php",
      "@php -l music-wave-core/src/Migrations/Schema040.php",
      "@php -l music-wave-core/src/Migrations/Schema050.php",
      "@php -l music-wave-core/src/Migrations/Schema070.php",
      "@php -l music-wave-core/src/Migrations/Schema080.php",
      "@php -l music-wave-core/src/Modules/Admin.php",
      "@php -l music-wave-core/src/Modules/Catalog.php",
      "@php -l music-wave-core/src/Modules/Commerce.php",
      "@php -l music-wave-core/src/Modules/Downloads.php",
      "@php -l music-wave-core/src/Modules/Diagnostics.php",
      "@php -l music-wave-core/src/Modules/Foundation.php",
      "@php -l music-wave-core/src/Modules/Library.php",
      "@php -l music-wave-core/src/Modules/Rendering.php",
      "@php -l music-wave-core/src/Modules/Seo.php",
      "@php -l music-wave-core/src/Playback/PlaybackQueueRoutes.php",
      "@php -l music-wave-core/src/Plugin.php",
      "@php -l music-wave-core/src/Support/Autoloader.php",
      "@php -l music-wave-core/src/Support/ModuleRegistry.php",
      "@php -l music-wave-core/src/Support/SiteHealth.php",
      "@php -l music-wave-core/src/Support/Settings.php",
      "@php -l music-wave-core/src/Schema/MetaDefinition.php",
      "@php -l music-wave-core/src/Schema/ReleaseMetaRegistry.php",
      "@php -l music-wave-core/src/Schema/ReleaseMetaSchema.php",
      "@php -l music-wave-core/src/Metadata/MetadataEnrichmentProvider.php",
      "@php -l music-wave-core/src/Metadata/MetadataTaxonomyMapper.php",
      "@php -l music-wave-core/src/Seo/ReleaseJsonLd.php",
	  "@php -l music-wave-core/src/Seo/ReleaseMetadata.php",
	  "@php -l music-wave-core/src/Seo/SeoCompatibility.php",
      "@php -l musicwave/functions.php",
      "@php -l musicwave/index.php",
      "@php -l musicwave/patterns/home-hero.php",
      "@php -l musicwave/patterns/account-hub.php",
      "@php -l music-wave-vip/music-wave-vip.php",
      "@php -l music-wave-vip/src/Autoloader.php",
      "@php -l music-wave-vip/src/Plugin.php",
      "@php -l music-wave-vip/src/ProtectedAssetRoutes.php",
      "@php -l music-wave-vip/src/ProtectedAssetStorage.php",
      "@php -l music-wave-vip/src/ProtectedFileProvider.php",
      "@php -l music-wave-vip/src/RoleMembershipProvider.php",
      "@php -l music-wave-vip/src/SettingsPage.php",
      "@php -l tools/package-release.php",
      "@php -l tools/generate-pot.php",
      "@php -l tools/check-js.php"
    ],
    "check:phpcs": "phpcs --standard=phpcs.xml music-wave-core musicwave",
    "check:phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=2G",
    "check:js": "@php tools/check-js.php",
    "make-pot": "@php tools/generate-pot.php",
    "test": "@php tests/run.php"
  }
}
