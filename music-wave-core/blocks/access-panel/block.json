{
	"apiVersion": 3,
	"name": "music-wave/access-panel",
	"title": "Release access panel",
	"category": "music-wave",
	"description": "Displays the current release access state and actions.",
	"keywords": [ "purchase", "membership", "restricted" ],
	"textdomain": "music-wave-core",
	"icon": "lock",
	"attributes": {
		"releaseId": { "type": "integer", "default": 0 },
		"layout": { "type": "string", "default": "banner" },
		"showWhenGranted": { "type": "boolean", "default": true },
		"grantedMessage": { "type": "string", "default": "" },
		"restrictedMessage": { "type": "string", "default": "" },
		"purchaseMessage": { "type": "string", "default": "" },
		"purchaseCtaLabel": { "type": "string", "default": "" },
		"membershipMessage": { "type": "string", "default": "" },
		"membershipCtaLabel": { "type": "string", "default": "" },
		"membershipCtaUrl": { "type": "string", "default": "" }
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"color": { "background": true, "link": true, "text": true },
		"spacing": { "blockGap": true, "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"example": {
		"attributes": {
			"layout": "banner",
			"showWhenGranted": true
		}
	}
}
