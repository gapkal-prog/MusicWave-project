{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/account-dashboard",
  "title": "داشبورد موسیقی کاربر",
  "category": "music-wave",
  "description": "منطقه حساب یکپارچه: کتابخانه موسیقی، سفارش‌ها، بارگیری‌ها، آدرس‌ها، روش‌های پرداخت، عضویت و فهرست‌های پخش در یک پیمایش.",
  "keywords": [
    "کتابخانه",
    "حساب کاربری",
    "عضویت",
    "سفارشات",
    "ووکامرس"
  ],
  "textdomain": "music-wave-core",
  "icon": "dashboard",
  "attributes": {
    "showLibrary": {
      "type": "boolean",
      "default": true
    },
    "showQuickLinks": {
      "type": "boolean",
      "default": true
    },
    "showStats": {
      "type": "boolean",
      "default": true
    },
    "showMembershipPanel": {
      "type": "boolean",
      "default": true
    },
    "showOrders": {
      "type": "boolean",
      "default": true
    },
    "showDownloads": {
      "type": "boolean",
      "default": true
    },
    "showAddresses": {
      "type": "boolean",
      "default": true
    },
    "showPaymentMethods": {
      "type": "boolean",
      "default": true
    },
    "showAccountDetails": {
      "type": "boolean",
      "default": true
    },
    "showSignOut": {
      "type": "boolean",
      "default": true
    },
    "introText": {
      "type": "string",
      "default": ""
    },
    "membershipHeading": {
      "type": "string",
      "default": ""
    },
    "libraryHeading": {
      "type": "string",
      "default": ""
    },
    "ordersHeading": {
      "type": "string",
      "default": ""
    },
    "downloadsHeading": {
      "type": "string",
      "default": ""
    },
    "addressesHeading": {
      "type": "string",
      "default": ""
    },
    "paymentHeading": {
      "type": "string",
      "default": ""
    },
    "accountHeading": {
      "type": "string",
      "default": ""
    },
    "playlistsHeading": {
      "type": "string",
      "default": ""
    },
    "notificationsHeading": {
      "type": "string",
      "default": ""
    },
    "panelOrder": {
      "type": "string",
      "default": "default"
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "background": true,
      "link": true,
      "text": true
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "example": {
    "attributes": {
      "showLibrary": true,
      "showQuickLinks": true,
      "showStats": true,
      "showMembershipPanel": true,
      "showOrders": true,
      "showDownloads": true,
      "showAddresses": true,
      "showPaymentMethods": true,
      "showAccountDetails": true,
      "showSignOut": true,
      "introText": "",
      "membershipHeading": "",
      "libraryHeading": "",
      "ordersHeading": "",
      "downloadsHeading": "",
      "addressesHeading": "",
      "paymentHeading": "",
      "accountHeading": "",
      "playlistsHeading": "",
      "notificationsHeading": "",
      "panelOrder": "default"
    }
  }
}
