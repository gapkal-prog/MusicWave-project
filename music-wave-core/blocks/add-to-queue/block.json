{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/add-to-queue",
  "title": "افزودن به صف",
  "category": "music-wave",
  "description": "انتشار فعلی یا سنجاق‌شده را به صف پخش شنونده اضافه می‌کند — بعد از قطعهٔ فعلی یا در پایان صف — بدون نیاز به JavaScript.",
  "keywords": [
    "صف",
    "پخش بعدی",
    "اضافه کردن",
    "پخش‌کننده"
  ],
  "textdomain": "music-wave-core",
  "icon": "controls-play",
  "attributes": {
    "releaseId": {
      "type": "integer",
      "default": 0
    },
    "position": {
      "type": "string",
      "default": "next"
    },
    "label": {
      "type": "string",
      "default": ""
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "link": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "example": {
    "attributes": {
      "position": "next"
    }
  }
}
