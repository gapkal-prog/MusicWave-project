{
	"apiVersion": 3,
	"name": "music-wave/artist-profile",
	"title": "Artist profile",
	"category": "music-wave",
	"description": "Displays the artist taxonomy profile on archive pages or any other template.",
	"keywords": [ "biography", "artist" ],
	"textdomain": "music-wave-core",
	"icon": "admin-users",
	"attributes": {
		"termId": { "type": "integer", "default": 0 },
		"layout": { "type": "string", "default": "card" },
		"showImage": { "type": "boolean", "default": true },
		"showTitle": { "type": "boolean", "default": true },
		"showBio": { "type": "boolean", "default": true },
		"showLink": { "type": "boolean", "default": true },
		"showLibraryButton": { "type": "boolean", "default": true },
		"imageSize": { "type": "string", "default": "medium" },
		"imageShape": { "type": "string", "default": "rounded" },
		"ctaLabel": { "type": "string", "default": "" },
		"bioLength": { "type": "integer", "default": 0 },
		"showReleaseCount": { "type": "boolean", "default": false },
		"accentColor": { "type": "string", "default": "" }
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"color": { "background": true, "link": true, "text": true },
		"spacing": { "blockGap": true, "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"example": {
		"attributes": {
			"layout": "card",
			"showImage": true,
			"showBio": true,
			"imageShape": "rounded"
		}
	}
}
