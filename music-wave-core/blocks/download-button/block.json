{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/download-button",
  "title": "دانلود ایمن",
  "category": "music-wave",
  "description": "اقدامات دانلود مجاز را برای یک انتشار نمایش می‌دهد.",
  "keywords": [
    "کیفیت",
    "جریان",
    "فایل‌ها"
  ],
  "textdomain": "music-wave-core",
  "icon": "download",
  "attributes": {
    "releaseId": {
      "type": "integer",
      "default": 0
    },
    "compact": {
      "type": "boolean",
      "default": false
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "showHeading": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "showQuality": {
      "type": "boolean",
      "default": true
    },
    "showStream": {
      "type": "boolean",
      "default": true
    },
    "downloadLabel": {
      "type": "string",
      "default": ""
    },
    "playLabel": {
      "type": "string",
      "default": ""
    },
    "loginLabel": {
      "type": "string",
      "default": ""
    }
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "background": true,
      "link": true,
      "text": true
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "example": {
    "attributes": {
      "showHeading": true,
      "showQuality": true,
      "showStream": true
    }
  }
}
