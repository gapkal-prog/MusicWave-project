{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "music-wave/request-form",
  "title": "فرم درخواست آهنگ و همکاری",
  "category": "music-wave",
  "description": "فرم عمومی سفارش آهنگ اختصاصی و پیشنهاد همکاری برای خواننده‌ها، برندها و مخاطبان؛ با حالت ترکیبی یا اختصاصی (فقط سفارش آهنگ / فقط همکاری)، بدون نیاز به جاوااسکریپت کار می‌کند و درخواست‌ها در بخش «درخواست‌ها و همکاری» مدیریت می‌شوند.",
  "keywords": [
    "درخواست",
    "همکاری",
    "سفارش آهنگ",
    "collaboration",
    "request",
    "تماس",
    "آهنگ اختصاصی"
  ],
  "textdomain": "music-wave-core",
  "icon": "microphone",
  "attributes": {
    "mode": {
      "type": "string",
      "enum": [
        "both",
        "song",
        "collab"
      ],
      "default": "both"
    },
    "defaultType": {
      "type": "string",
      "default": ""
    },
    "showTypeChips": {
      "type": "boolean",
      "default": true
    },
    "showRoles": {
      "type": "boolean",
      "default": true
    },
    "defaultRole": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "showHeading": {
      "type": "boolean",
      "default": true
    },
    "showSteps": {
      "type": "boolean",
      "default": true
    },
    "showHighlights": {
      "type": "boolean",
      "default": true
    },
    "highlight1Title": {
      "type": "string",
      "default": ""
    },
    "highlight1Text": {
      "type": "string",
      "default": ""
    },
    "highlight2Title": {
      "type": "string",
      "default": ""
    },
    "highlight2Text": {
      "type": "string",
      "default": ""
    },
    "highlight3Title": {
      "type": "string",
      "default": ""
    },
    "highlight3Text": {
      "type": "string",
      "default": ""
    },
    "step1": {
      "type": "string",
      "default": ""
    },
    "step2": {
      "type": "string",
      "default": ""
    },
    "step3": {
      "type": "string",
      "default": ""
    },
    "privacyNote": {
      "type": "string",
      "default": ""
    },
    "showBudget": {
      "type": "boolean",
      "default": true
    },
    "showDeadline": {
      "type": "boolean",
      "default": true
    },
    "showPhone": {
      "type": "boolean",
      "default": true
    },
    "showLinks": {
      "type": "boolean",
      "default": true
    },
    "submitLabel": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "enum": [
        "split",
        "stacked"
      ],
      "default": "split"
    }
  },
  "supports": {
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "link": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "example": {
    "attributes": {
      "mode": "both",
      "heading": "آهنگ اختصاصی یا همکاری می‌خواهید؟",
      "layout": "split"
    }
  },
  "style": "music-wave-request-form",
  "editorStyle": "music-wave-request-form"
}
