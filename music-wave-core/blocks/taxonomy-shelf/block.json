{
	"apiVersion": 3,
	"name": "music-wave/taxonomy-shelf",
	"title": "Taxonomy shelf",
	"category": "music-wave",
	"description": "Displays genres, moods, or labels as tappable browse tiles with release counts, in a grid, rail, or list.",
	"keywords": [ "genres", "moods", "labels", "browse", "categories", "shelf" ],
	"textdomain": "music-wave-core",
	"icon": "tag",
	"attributes": {
		"taxonomy": { "type": "string", "default": "mw_genre" },
		"source": { "type": "string", "default": "all" },
		"termIds": { "type": "string", "default": "" },
		"orderBy": { "type": "string", "default": "count" },
		"itemsToShow": { "type": "integer", "default": 8 },
		"columns": { "type": "integer", "default": 4 },
		"layout": { "type": "string", "default": "grid" },
		"cardStyle": { "type": "string", "default": "colorful" },
		"showCount": { "type": "boolean", "default": true },
		"eyebrow": { "type": "string", "default": "" },
		"heading": { "type": "string", "default": "" },
		"description": { "type": "string", "default": "" },
		"showHeading": { "type": "boolean", "default": true },
		"sectionUrl": { "type": "string", "default": "" },
		"sectionLinkLabel": { "type": "string", "default": "" },
		"emptyMessage": { "type": "string", "default": "" }
	},
	"supports": {
		"anchor": true,
		"align": [ "wide", "full" ],
		"border": { "color": true, "radius": true, "style": true, "width": true },
		"color": { "background": true, "link": true, "text": true },
		"spacing": { "blockGap": true, "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true }
	},
	"example": {
		"attributes": {
			"heading": "Browse by mood",
			"taxonomy": "mw_mood",
			"layout": "scroll",
			"cardStyle": "colorful",
			"itemsToShow": 10
		}
	}
}
