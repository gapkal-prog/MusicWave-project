msgstr "Open release"

msgid "فرادادهٔ انتشار"
msgstr "Release metadata"

msgid "انتشار فعلی"
msgstr "Current release"

msgid "انتشار فعلی را به یکی از فهرست‌های پخش شنونده اضافه می‌کند."
msgstr "Adds the current release to one of the listener's playlists."

msgid "انتشار فعلی یا سنجاق‌شده را به صف پخش شنونده اضافه می‌کند — بعد از قطعهٔ فعلی یا در پایان صف — بدون نیاز به JavaScript."
msgstr ""
"Adds the current or pinned release to the listener's play queue — next in line or "
"at the end — without JavaScript."

msgid "انتشار نمونهٔ %s رد شد، چون یک انتشار تجاری از نامک نشانیِ آن استفاده می‌کند."
msgstr "Skipped demo release %s because a merchant release already uses its URL slug."

msgid "انتشار یا هنرمند معتبری را برای حذف انتخاب کنید."
msgstr "Choose a valid release or artist to remove."

msgid "انتشارات جدید از هنرمندانی که دنبال می‌کنم"
msgstr "New releases from artists I follow"

msgid "انتشارهای مرتبط"
msgstr "Related releases"

msgid "انتشارات منتشرشده"
msgstr "Published releases"

msgid "انتشارهای آزمایشی حاوی داده‌های دارایی، محصول، مشتری یا عضویت حفاظت‌شده نیستند. با حذف آن‌ها، اصطلاحاتی که ممکن است قبلاً استفاده می‌کنید حفظ شود."
msgstr ""
"Demo releases contain no protected asset, product, customer, or membership data. Removing "
"them preserves any terms that you may already be using."

msgid "انتشارهای اخیراً پخش‌شده"
msgstr "Recently played releases"

msgid "انتشارهای حفاظت‌شده فعلی شما در اینجا ظاهر می‌شوند. با شروع هر بارگیری، دسترسی دوباره بررسی می‌شود."
msgstr ""
"Your currently available protected releases appear here. Access is checked again when "
"each download starts."

msgid "انتشارهای در حال پیشرفت"
msgstr "In-progress releases"

msgid "انتشارهای ذخیره‌شده"
msgstr "Saved releases"

msgid "انتشارهای ذخیره‌شده به علاوه بر هر بارگیری حفاظت‌شده‌ای که بازدیدکننده حق آن را دارد."
msgstr "Saved releases plus every protected download the visitor is entitled to."

msgid "انتشارهای مرتبط MusicWave را نمایش می‌دهد."
msgstr "Displays related MusicWave releases."

msgid "انتشارهای مشابه"
msgstr "Similar releases"

msgid "انتشارهای پیش‌نویس"
msgstr "Draft releases"

msgid "انتشارهای کودک را در یک مجموعه نمایش می‌دهد."
msgstr "Displays child releases in a collection."

msgid "انتشارها را در دسته‌های 200 به‌روزرسانی کنید. حال‌وهواهای خرید و عضویت فقط زمانی اعمال می‌شوند که هر انتشار قبلاً محصول یا نگاشت سطح موردنیاز را داشته باشد. انتشارهای ناقص نادیده گرفته می‌شوند."
msgstr ""
"Update releases in batches of 200. Purchase and membership modes are applied only "
"when each release already has the required product or level mapping; incomplete releases "
"are skipped."

msgid "انتقال اول"
msgstr "First Transmission"

msgid "اندازه تصویر"
msgstr "Image size"

msgid "اندازه فایل بر حسب بایت"
msgstr "File size in bytes"

msgid "انواع انتشار"
msgstr "Release types"

msgid "اولویت ترکیبی به‌روزرسانی شد."
msgstr "Shuffle preference updated."

msgid "اولویت تکرار ذخیره نشد."
msgstr "The repeat preference could not be saved."

msgid "اولین فهرست پخش خود را بسازید"
msgstr "Create your first playlist"

msgid "اپیزود"
msgstr "Episode"

msgid "اگر چیزی مطابق انتظار عمل نکرد، با بررسی محیط و راهنمای شروع سریع شروع کنید، سپس صفحه سلامت سایت WordPress را مرور کنید."
msgstr ""
"If something does not behave as expected, start with the environment checks and the "
"quick-start guide, then review the WordPress Site Health screen."

msgid "ایجاد اولین انتشار"
msgstr "Create the first release"

msgid "ایجاد شد"
msgstr "Created"

msgid "ایجاد فهرست پخش"
msgstr "Create playlist"

msgid "ایجاد و اضافه کردن"
msgstr "Create & add"

msgid "ایمیل‌های انتشاری را که می‌خواهید انتخاب کنید."
msgstr "Choose which release emails you want."

msgid "این انتشار برای پخش در دسترس نیست."
msgstr "This release is not available for playback."

msgid "این انتشار در حال حاضر برای فهرست‌های پخش در دسترس نیست."
msgstr "That release is not available for playlists right now."

msgid "این انتشار در حال حاضر در دسترس نیست."
msgstr "This release is not currently available."

msgid "این انتشار در حال حاضر صدای قابل پخش ندارد."
msgstr "This release has no playable audio right now."

msgid "این انتشار را بخرید تا قفل پخش کامل باز شود."
msgstr "Purchase this release to unlock full playback."

msgid "این انتشار را یک بار ذخیره کنید تا فایل‌ها و موارد مجموعه حفاظت‌شده را اضافه کنید."
msgstr "Save this release once to add protected files and collection items."

msgid "این بلوک آماده است و وقتی داده‌های موردنیاز MusicWave در دسترس باشند، نمایش داده می‌شود."
msgstr "This block is ready and will render when its required MusicWave data is available."

msgid "این بلوک را در یک انتشار پیش‌نمایش کنید یا با انتخابگر انتشار، یک مورد را سنجاق کنید. شنوندگان واردشده آن را فوراً در صف قرار می‌دهند."
msgstr ""
"Preview this block on a release, or pin one with the release picker. Signed-in listeners "
"queue it instantly."

msgid "این جلسه حساب را ایمن ببندید."
msgstr "Securely close this account session."

msgid "این خودکار را در قالب‌های انتشار و حلقه‌های پرس‌وجو بگذارید. تنها زمانی یک انتشار ثابت را انتخاب کنید که بلوک همیشه آن انتشار را نشان دهد."
msgstr ""
"Leave this automatic in release templates and Query Loops. Select a fixed release "
"only when the block should always show that release."

msgid "این دکمه انتشار انتخاب‌شده را در کتابخانه شخصی یک بازدیدکننده ذخیره می‌کند، یا زمانی که یک اصطلاح هنرمند ID تنظیم می‌شود، هنرمند را دنبال می‌کند."
msgstr ""
"The button saves the selected release to a visitor's personal library, or follows "
"an artist when an artist term ID is set."

msgid "این صفحه شما را در راه‌اندازی فروشگاه MusicWave راهنمایی می‌کند:"
msgstr "This screen walks through launching a MusicWave store:"

msgid "این عنوان همه نسخه‌های یک آهنگ، قسمت یا فایل جایزه را گروه‌بندی می‌کند."
msgstr "This title groups all versions of the same song, episode, or bonus file."

msgid "این فایل در دسترس نیست یا حساب شما به آن دسترسی ندارد."
msgstr "This file is unavailable or your account does not have access to it."

msgid "این فهرست پخش برای همیشه حذف شود؟"
msgstr "Delete this playlist permanently?"

msgid "این فهرست پخش به حداکثر 500 قطعه رسیده است."
msgstr "This playlist has reached the maximum of 500 tracks."

msgid "این فهرست پخش خالی است یا قابل پخش نیست."
msgstr "This playlist is empty or not playable."

msgid "این فهرست پخش خالی است."
msgstr "This playlist is empty."

msgid "این فهرست پخش خالی است. در هر انتشار از «افزودن به فهرست پخش» استفاده کنید."
msgstr "This playlist is empty. Use “Add to playlist” on any release."

msgid "این فهرست پخش در حال حاضر صدای قابل پخش ندارد."
msgstr "This playlist has no playable audio right now."

msgid "این قسمت نمونه عمومی برای نمایش فرادادهٔ قسمت پادکست و سفارش مجموعه گنجانده شده است."
msgstr ""
"This public sample episode is included to demonstrate podcast episode metadata and "
"collection ordering."

msgid "این مقادیر هنگام ایجاد انتشار جدید ذخیره می‌شوند. انتشارهای موجود هرگز بی‌سروصدا بازنویسی نمی‌شوند."
msgstr ""
"These values are stored when a new release is created. Existing releases are never "
"silently rewritten."

msgid "این مورد به کتابخانه شما اضافه نشد."
msgstr "This item could not be added to your library."

msgid "این نماد در صورت پنهان‌شدن در دسترس فناوری کمکی قرار می‌گیرد."
msgstr "The icon stays available to assistive technology when hidden."

msgid "این سربرگ به‌طور خودکار در آرشیوهای هنرمند، ژانر، حال‌وهوا و برچسب ارائه می‌شود."
msgstr "This header renders automatically on artist, genre, mood, and label archives."

msgid "این فهرست بررسی مانع پیش‌نویس یا انتشار نمی‌شود؛ در عوض، داده‌های ناقص کاتالوگ را هنگام بازبینی تحریریه قابل مشاهده می‌کند."
msgstr ""
"This checklist does not block drafts or publishing. It makes missing catalog data "
"visible during editorial review."

msgid "بارگذاری فایل‌های بیشتر"
msgstr "Load more files"

msgid "بارگذاری یک کیفیت"
msgstr "Upload a quality"

msgid "باز کردن %s"
msgstr "Open %s"

msgid "باز کردن تنظیمات مستقل"
msgstr "Open standalone settings"

msgid "باز کردن تنظیمات پیوندهای یکتا"
msgstr "Open permalink settings"

msgid "باز کردن سلامت سایت"
msgstr "Open Site Health"

msgid "باز کردن سلامت سایت WordPress"
msgstr "Open WordPress Site Health"

msgid "باز کردن صفحهٔ افزونه‌ها"
msgstr "Open Plugins screen"

msgid "باز کردن مرورگر تم"
msgstr "Open theme browser"

msgid "باز کردن مرکز کنترل"
msgstr "Open control center"

msgid "باز کردن ویرایشگر سایت"
msgstr "Open Site Editor"

msgid "بازدیدکنندگان همچنان می‌توانند حالت مرتب‌سازی دیگری را انتخاب کنند."
msgstr "Visitors can still choose another sorting mode."

msgid "بازنشانی"
msgstr "Reset"

msgid "بازنشانی برچسب پیوند"
msgstr "Reset link label"

msgid "پخش"
msgstr "Play"

msgid "پخش %s"
msgstr "Play %s"

msgid "پخش بعدی"
msgstr "Play next"

msgid "بایگانی‌های انتشار، هنرمند و طبقه‌بندی می‌توانند از URL‌های متعارف قابل خواندن استفاده کنند."
msgstr "Release, artist, and taxonomy archives can use readable canonical URLs."

msgid "بخش انتشارات مشابه"
msgstr "Similar releases section"

msgid "بخش مربوط به همان هنرمند را به آرشیو هنرمند و بخش مشابه را به کاتالوگ پیوند می‌دهد."
msgstr ""
"Links the same-artist section to the artist archive and the similar section to the "
"catalog."

msgid "بخش‌ها"
msgstr "Sections"

msgid "بخش‌های حساب"
msgstr "Account sections"

msgid "بخش همان هنرمند"
msgstr "Same-artist section"

msgid "بخش‌های مرتبط زمانی ظاهر می‌شوند که انتشار انتخابی هنرمندان، ژانرها، حال‌وهواها یا انواع انتشار را با انتشارهای دیگر به اشتراک بگذارد."
msgstr ""
"Related sections appear when the selected release shares artists, genres, moods, or "
"release types with other releases."

msgid "بدون عنوان"
msgstr "Untitled"

msgid "برای URLهای کاتالوگ، هنرمند و بایگانی قابل خواندن از یک ساختار غیر پیش‌فرض استفاده کنید."
msgstr "Use a non-default structure for readable catalog, artist, and archive URLs."

msgid "برای استفاده از برچسب پخش بعدی یا افزودن به صف، خالی بگذارید."
msgstr "Leave empty to use the default Play next or Add to queue label."

msgid "برای استفاده از برچسب پیش‌فرض MusicWave ترجمه‌شده، یک فیلد خالی بگذارید."
msgstr "Leave a field empty to use the translated MusicWave default label."

msgid "برای استفاده از برچسب پیش‌فرض خالی بگذارید."
msgstr "Leave empty to use the default label."

msgid "برای استفاده از پیش‌فرض هوشمند، خالی بگذارید: به گوش‌دادن ادامه دهید یا اخیراً پخش‌شده است."
msgstr "Leave empty to use the smart default: Continue listening or Recently played."

msgid "برای استفاده از عنوان پیش‌فرض ترجمه‌شده خالی بگذارید."
msgstr "Leave empty to use the translated default heading."

msgid "برای استفاده از ویژگی‌های گوش‌دادن وارد سیستم شوید."
msgstr "Sign in to use listening features."

msgid "برای استفاده از پیام یا تنظیم جهانی MusicWave، خالی بگذارید."
msgstr "Leave empty to use the global MusicWave message or setting."

msgid "برای استفاده از پیش‌فرض MusicWave ترجمه‌شده، یک فیلد خالی بگذارید. متن سفارشی قبل از خروجی حذف می‌شود."
msgstr ""
"Leave a field blank to use the translated MusicWave default. Custom text is escaped "
"before output."

msgid "برای استفاده از پیش‌فرض ترجمه‌شده، یک برچسب خالی بگذارید."
msgstr "Leave a label empty to use the translated default."

msgid "برای استفاده از پیش‌فرض‌های ترجمه‌شده، برچسب‌ها را خالی بگذارید. مرتب‌سازی پیش‌فرض از تنظیمات بایگانی MusicWave پیروی می‌کند."
msgstr ""
"Leave labels empty to use the translated defaults. The default sort follows the MusicWave "
"archive setting."

msgid "برای استفاده از پیش‌فرض‌های ترجمه‌شده، متون را خالی بگذارید."
msgstr "Leave texts empty to use the translated defaults."

msgid "برای ایجاد فهرست پخش از کاتالوگ خود وارد سیستم شوید."
msgstr "Sign in to build playlists from your catalog."

msgid "برای ایجاد کتابخانه شخصی خود وارد سیستم شوید: آهنگ‌ها، آلبوم‌ها، پادکست‌ها را ذخیره کنید و هنرمندان موردعلاقهٔ خود را دنبال کنید."
msgstr ""
"Sign in to build your personal library: save songs, albums, podcasts, and follow your "
"favorite artists."

msgid "برای باز کردن تجربهٔ کامل، این انتشار را خریداری کنید."
msgstr "Purchase this release to unlock the full experience."

msgid "برای باز کردن داشبورد موسیقی خود وارد شوید"
msgstr "Sign in to open your music dashboard"

msgid "برای به ارث بردن برچسب پیش‌فرض MusicWave ترجمه‌شده، خالی بگذارید."
msgstr "Leave empty to inherit the translated MusicWave default label."

msgid "برای جست‌وجو در کاتالوگ حداقل نویسه‌های %d را وارد کنید."
msgstr "Enter at least %d characters to search the catalog."

msgid "برای حفظ صف پخش در بین صفحات و بازدیدها وارد سیستم شوید."
msgstr "Sign in to keep a play queue across pages and visits."

msgid "برای دسترسی به این انتشار به عضویت واجد شرایط نیاز است."
msgstr "An eligible membership is required to access this release."

msgid "برای دسترسی به خرید، حداقل یک محصول WooCommerce را نگاشت کنید."
msgstr "Map at least one WooCommerce product for purchase access."

msgid "برای ذخیره پیشرفت پخش، سابقهٔ گوش‌دادن را در حساب خود فعال کنید."
msgstr "Enable listening history in your account to save playback progress."

msgid "برای فروش انتشارهای منتشرشده لازم است. محتوای کاتالوگ عمومی رایگان بدون آن کار می‌کند."
msgstr "Required to sell releases. Free public catalog content works without it."

msgid "برای مدیریت اعلان‌ها وارد سیستم شوید."
msgstr "Sign in to manage notifications."

msgid "برای مدیریت صف خود وارد سیستم شوید."
msgstr "Sign in to manage your queue."

msgid "برای مدیریت فهرست‌های پخش وارد سیستم شوید."
msgstr "Sign in to manage playlists."

msgid "برای مدیریت کتابخانه موسیقی شخصی خود وارد سیستم شوید."
msgstr "Sign in to manage your personal music library."

msgid "برای مشاهده عضویت خود وارد شوید."
msgstr "Sign in to view your membership."

msgid "برای نمایش بخش اعتبار، حداقل یک اعتبار در جزئیات انتشار اضافه کنید."
msgstr "Add at least one credit in the release details to display the credits section."

msgid "برای نمایش دکمه پخش، نشانی HTTPS امنِ پیش‌نمایش را به انتشار انتخاب‌شده اضافه کنید."
msgstr "Add a secure HTTPS preview URL to the selected release to display the play button."

msgid "برای نمایش پخش‌کننده، یک نشانی HTTPS امنِ پیش‌نمایش به انتشار انتخاب‌شده اضافه کنید."
msgstr "Add a secure HTTPS preview URL to the selected release to display the player."

msgid "برای هدف‌گرفتن انتشار انتخاب‌شده، مقدار ۰ را وارد کنید. برای دنبال‌کردن آن هنرمند، به‌جای آن شناسهٔ عددی طبقه‌بندی هنرمند را وارد کنید."
msgstr ""
"Leave 0 to target the selected release. Enter a numeric artist taxonomy ID to follow "
"that artist instead."

msgid "برای هر آهنگ، قسمت یا بسته یک فایل قابل دانلود ایجاد کنید. سپس تمام کیفیت‌های موجود را به آن فایل اضافه کنید. این کار آلبوم‌ها و پادکست‌ها را بدون آپلود مجدد همان صدا سازماندهی می‌کند."
msgstr ""
"Create a downloadable file for every song, episode, or bundle. Then add all available "
"qualities to that file. This keeps albums and podcasts organized without uploading "
"the same audio again."

msgid "برای پشتیبانی از کاتالوگ قابل پیش‌بینی و هنرمندان URL، هر ساختار پیوند ثابت غیر پیش‌فرض را ذخیره کنید."
msgstr "Save any non-default permalink structure to support predictable catalog and artist URLs."

msgid "برای پیگیری چیزهایی که پخش می‌کنید، وارد سیستم شوید و از همان‌جایی که متوقف کرده‌اید ادامه دهید."
msgstr "Sign in to keep track of what you play and pick up right where you left off."

msgid "برای گوش‌دادن به قطعه‌های کامل بدون محدودیت مشترک شوید."
msgstr "Subscribe to listen to full tracks without limits."

msgid "بررسی"
msgstr "Review"

msgid "بررسی افزونه‌ها"
msgstr "Review plugins"

msgid "بررسی انواع انتشار و هنرمندان"
msgstr "Review release types and artists"

msgid "بررسی در سلامت سایت"
msgstr "Review in Site Health"

msgid "بررسی‌های محیطی — موارد لازم برای راه‌اندازی را مسدود می‌کنند. موارد توصیه‌شده صرفاً جنبهٔ راهنمایی دارند."
msgstr "Environment checks — required items block launch; recommended items are advisory."

msgid "بررسی‌های لازم: %d مورد به توجه نیاز دارند."
msgstr "%d required checks need attention"

msgid "بررسی‌های محیطی %1$d از %2$d انجام شد."
msgstr "%1$d of %2$d environment checks passed."

msgid "بررسی‌های محیطی %1$d از %2$d انجام شد. قبل از راه‌اندازی فروشگاه، مواردی را که در زیر «لازم است» مشخص شده‌اند حل کنید."
msgstr ""
"%1$d of %2$d environment checks passed. Resolve the items marked “Required” below "
"before launching the store."

msgid "زمان‌بندی‌شده"
msgstr "Scheduled"

msgid "برچسب"
msgstr "Label"

msgid "برچسب حالت ذخیره‌شده"
msgstr "Saved state label"

msgid "برچسب دکمه"
msgstr "Button label"

msgid "برچسب دکمه خرید"
msgstr "Purchase button label"

msgid "برچسب دکمه دانلود"
msgstr "Download button label"

msgid "برچسب دکمه رضایت"
msgstr "Consent button label"

msgid "برچسب دکمه عضویت"
msgstr "Membership button label"

msgid "برچسب دکمه ورود"
msgstr "Sign-in button label"

msgid "برچسب دکمه پخش"
msgstr "Play button label"

msgid "برچسب دکمه پیوند"
msgstr "Link button label"

msgid "برچسب فیلد"
msgstr "Field label"

msgid "برچسب مشتری"
msgstr "Customer label"

msgid "برچسب‌ها"
msgstr "Labels"

