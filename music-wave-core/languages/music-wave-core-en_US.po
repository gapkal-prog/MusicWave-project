msgid "آن درخواست فهرست پخش معتبر نبود. دوباره امتحان کنید."
msgstr "That playlist request was not valid. Try again."

msgid "آن فهرست پخش ایجاد نشد. نام و محدودیت فهرست پخش خود را بررسی کنید."
msgstr "That playlist could not be created. Check the name and your playlist limit."

msgid "آن فهرست پخش به‌روز نمی‌شود."
msgstr "That playlist could not be updated."

msgid "آن فهرست پخش در دسترس نیست."
msgstr "That playlist is not available."

msgid "آن فهرست پخش قابل حذف نیست."
msgstr "That playlist could not be deleted."

msgid "آن مورد منتشر نشده است و نمی‌توان آن را به فهرست پخش اضافه کرد."
msgstr "That item is not a release and cannot be added to a playlist."

msgid "آهنگ‌ها، آلبوم‌ها، پادکست‌ها و هنرمندان ذخیره‌شده."
msgstr "Saved songs, albums, podcasts, and artists."

msgid "آهنگ، آلبوم، پادکست یا برچسب هنرمند را نمایش می‌دهد."
msgstr "Displays the song, album, podcast, or artist label."

msgid "آهنگ‌ها، آلبوم‌ها، پادکست‌ها و هنرمندانی را که بازدیدکننده ذخیره کرده‌اند را نمایش می‌دهد."
msgstr "Displays the visitor's saved songs, albums, podcasts, and followed artists."

msgid "آپلود فایل جدید"
msgstr "Upload a new file"

msgid "آپلود فایل حفاظت‌شده و خواندن فرادادهٔ آن…"
msgstr "Uploading protected file and reading its metadata…"

msgid "ابتدا عضویت"
msgstr "Membership first"

msgid "فراداده ذخیره شد، اما وارد کردن جلد ممکن نبود: %s"
msgstr "The metadata was saved, but the cover could not be imported: %s"

