msgstr "The protected asset directory is unavailable or not writable."

msgid "پوشهٔ حفاظت‌شده باید وجود داشته باشد، خواندنی باشد و خارج از پوشهٔ عمومی وردپرس بماند. مقدار قبلی حفظ شد."
msgstr ""
"The protected directory must exist, be readable, and remain outside the public WordPress "
"directory. The previous value was kept."

