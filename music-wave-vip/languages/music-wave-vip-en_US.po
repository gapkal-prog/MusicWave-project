msgid "%d روز"
msgid_plural "%d روز"
msgstr[0] "%d day"
msgstr[1] "%d days"

msgid "%d سال"
msgid_plural "%d سال"
msgstr[0] "%d year"
msgstr[1] "%d years"

msgid "%d ماه"
msgid_plural "%d ماه"
msgstr[0] "%d month"
msgstr[1] "%d months"

msgid "(داخل public_html نباشد)."
msgstr "(not inside public_html)."

msgid "+ ایجاد محصول طرح جدید"
msgstr "+ Create new plan product"

msgid "Apache/LiteSpeed X-Sendfile"
msgstr "Apache/LiteSpeed X-Sendfile"

msgid "HMAC همهٔ پارامترها (path، expiry، mode و kid) را پوشش می‌دهد تا امکان دستکاری هیچ‌کدام نباشد."
msgstr ""
"Every param (path, expiry, mode, kid) is covered by the HMAC so none can be tampered "
"with."

msgid "MusicWave VIP"
msgstr "MusicWave VIP"

msgid "MusicWave VIP به افزونهٔ MusicWave Core نیاز دارد."
msgstr "MusicWave VIP requires the MusicWave Core plugin."

msgid "TTL کوتاه بازپخش را محدود می‌کند. token هسته (۵ تا ۱۵ دقیقه) و TTL نشانی راه‌دور هر دو اعمال می‌شوند؛ مجوز دسترسی در هر تحویل دوباره بررسی می‌شود."
msgstr ""
"Short TTL limits replay. Core token (5–15 min) + remote URL TTL both apply; entitlement "
"is re-checked on every delivery."

msgid "WooCommerce Memberships (در صورت نیاز با پیشوند plan-)"
msgstr "WooCommerce Memberships (plan- prefix when needed)"

msgid "WooCommerce Subscriptions (subscription-123 یا شناسهٔ محصول)"
msgstr "WooCommerce Subscriptions (subscription-123 or product ID)"

msgid "asset حفاظت‌شده ذخیره نشد."
msgstr "The protected asset could not be stored."

msgid "level — نامک سطح عضویت (a-z، 0-9، _ و -) که با فیلد «سطح‌های عضویت» انتشار مطابقت دارد."
msgstr ""
"level — membership level slug (a-z, 0-9, _, -) matching the release “Membership levels” "
"field."

msgid "nginx X-Accel-Redirect"
msgstr "nginx X-Accel-Redirect"

msgid "«سیاست دسترسی» تنها مرجع معتبر باقی می‌ماند. یک یا چند منبع عضویت را انتخاب کنید؛ کاربر برای دسترسی به انتشارهای محدودشده باید دست‌کم یک سطح منطبق داشته باشد. سطح‌ها نامک‌های ساده‌ای هستند که برای هر انتشار تعریف می‌کنید (مثلاً gold یا vipgold)."
msgstr ""
"Access Policy remains the single source of truth. Select one or more membership sources;"
" a user needs at least one matching level to access restricted releases. Levels are "
"plain slugs you define per release (e.g. gold, vipgold)."

msgid "آداپترهای عضویت و مجوز دسترسی"
msgstr "Membership and entitlement adapters"

msgid "اجازهٔ مدیریت طرح‌های VIP را ندارید."
msgstr "You are not allowed to manage VIP plans."

msgid "ارائه‌دهندهٔ تحویل"
msgstr "Delivery provider"

msgid "ارتقای نقش VIP"
msgstr "VIP role promotion"

msgid "اعطای نقش VIP MusicWave (mw_vip)"
msgstr "Grant the MusicWave VIP role (mw_vip)"

msgid "اعمال عضویت VIP خاموش است — همهٔ انتشارهای مشروط به عضویت فعلاً برای همه رایگان‌اند (حتی مهمان‌ها)."
msgstr ""
"VIP membership enforcement is OFF — every membership-gated release is currently free "
"for everyone (guests included)."

msgid "اعمال عضویت VIP روشن است."
msgstr "VIP membership enforcement is ON."

msgid "اعمال قوانین VIP"
msgstr "VIP enforcement"

msgid "اعمال قوانین خاموش است؛ بنابراین این گزینه‌ها فقط خواندنی‌اند و اعمال نمی‌شوند. پیکربندی شما حفظ می‌شود و به‌محض روشن‌کردن دوبارهٔ کلید اصلی ادامه پیدا می‌کند."
msgstr ""
"Enforcement is switched off, so these options are read-only and not applied. Your "
"configuration is preserved and resumes the moment the master switch is turned back "
"on."

msgid "اعمال قوانین روشن است"
msgstr "Enforcement on"

msgid "امنیت اصلی با نگه‌داشتن پوشه خارج از ریشهٔ وب تأمین می‌شود؛ .htaccess/web.config فقط لایهٔ دفاعی مضاعف‌اند."
msgstr ""
"Primary security is keeping the folder outside the web root; .htaccess/web.config "
"are defense-in-depth only."

msgid "انتشارها"
msgstr "Releases"

msgid "انتشارهای مشروط به عضویت به سطح عضویت معتبر نیاز دارند، اعطای طرح‌ها خودکار انجام می‌شود و دانلودهای حفاظت‌شده از قوانین دسترسی زیر پیروی می‌کنند."
msgstr ""
"Membership-gated releases require a valid membership level, plan grants are processed "
"automatically, and protected downloads follow the access rules below."

msgid "اگر دانلودهای حفاظت‌شده یا عضویت درست کار نمی‌کنند، از بررسی‌های محیط MusicWave و صفحهٔ سلامت سایت وردپرس شروع کنید."
msgstr ""
"If protected downloads or memberships misbehave, start with the MusicWave environment "
"checks and the WordPress Site Health screen."

msgid "ایجاد"
msgstr "Generate"

msgid "ایجاد با: openssl rand -hex 32"
msgstr "Generate: openssl rand -hex 32"

msgid "ایجاد طرح‌های پیش‌فرض (۱، ۶ و ۱۲ ماهه)"
msgstr "Create default plans (1 / 6 / 12 months)"

msgid "ایجاد محصولات طرح پیش‌فرض ناموفق بود. آیا ووکامرس فعال است؟"
msgstr "Creating the default plan products failed. Is WooCommerce active?"

msgid "این صفحه تنها محل پیکربندی همهٔ گزینه‌های MusicWave VIP است:"
msgstr "This page is the single place where every MusicWave VIP option is configured:"

msgid "این نقش فقط قابلیت خواندن دارد تا حساب‌های VIP در کاربران → همهٔ کاربران قابل شناسایی باشند. تصمیم‌های دسترسی هرگز فقط به نقش وابسته نیستند؛ اعطا و انقضا به‌صورت زنده بررسی می‌شوند. فعال بگذارید."
msgstr ""
"The role has only the read capability so VIP accounts are identifiable in Users → "
"All Users. Access decisions never depend on the role alone; they re-check grants and "
"expiry live. Leave enabled."

msgid "این نگاشت طرح حذف شود؟ خود محصول ووکامرس حذف نمی‌شود."
msgstr "Remove this plan mapping? The WooCommerce product itself is not deleted."

msgid "با ثابت MUSIC_WAVE_VIP_PROTECTED_ROOT در wp-config.php جایگزین می‌شود. برای تغییر، wp-config.php را ویرایش کنید."
msgstr ""
"Overridden by wp-config.php constant MUSIC_WAVE_VIP_PROTECTED_ROOT. Edit wp-config."
"php to change."

msgid "با ذخیره‌سازی محلی حفاظت‌شده شروع کنید. فقط وقتی از تغییرمسیر راه‌دور استفاده کنید که میزبان شما پارامترهای expires، signature و mode زیر را بپذیرد یا توسعه‌دهنده فیلتر music_wave_vip_remote_download_url را متصل کرده باشد."
msgstr ""
"Start with Local protected storage. Use Remote redirect only when your host accepts "
"the expires, signature, and mode query parameters described below, or when a developer "
"connects the music_wave_vip_remote_download_url filter."

msgid "بارگذاری asset حفاظت‌شده معتبر نیست."
msgstr "The protected asset upload was invalid."

msgid "باز کردن تنظیمات VIP"
msgstr "Open VIP settings"

msgid "باز کردن راه‌اندازی و عیب‌یابی"
msgstr "Open Setup & diagnostics"

msgid "باز کردن سلامت سایت"
msgstr "Open Site Health"

msgid "باز کردن ووکامرس → محصولات"
msgstr "Open WooCommerce → Products"

msgid "بازدیدکنندگان برای پخش یا دانلود صدای حفاظت‌شده باید ثبت‌نام و وارد شوند (پیشنهادشده)."
msgstr "Visitors must register and sign in to stream or download protected audio (recommended)."

msgid "باید HTTPS باشد. نشانی نهایی = base / prefix / asset-id. میزبان در فهرست مجاز است."
msgstr "Must be HTTPS. Final URL = base / prefix / asset-id. Host is allowlisted."

msgid "برای استفاده از پوشهٔ خودکار کنار وردپرس (وقتی قطعی است که خارج از ریشهٔ وب است) خالی بگذارید."
msgstr ""
"Leave blank to use the auto-provisioned folder beside WordPress (when provably outside "
"the web root)."

msgid "برای ایجاد و فروش محصولات طرح، ووکامرس را فعال کنید."
msgstr "Activate WooCommerce to create and sell plan products."

msgid "برای محیط عملیاتی اکیداً پیشنهاد می‌شود:"
msgstr "Strongly recommended for production:"

msgid "برای یکپارچه‌سازی سفارشی از طریق فیلتر music_wave_vip_membership_access."
msgstr "For custom integrations via music_wave_vip_membership_access filter."

msgid "به افزونهٔ WooCommerce Memberships نیاز دارد."
msgstr "Requires WooCommerce Memberships extension."

msgid "به افزونهٔ WooCommerce Subscriptions نیاز دارد."
msgstr "Requires WooCommerce Subscriptions extension."

msgid "به انتشار → دسترسی بروید، «عضویت» را انتخاب کنید و همان سطح (vipgold) را در «سطح‌های عضویت» وارد کنید."
msgstr ""
"Edit the Release → Access → pick “Membership” and enter the same level (vipgold) in "
"Membership levels."

msgid "تا وقتی کلید اصلی خاموش است، گزینه‌های عضویت فقط خواندنی‌اند و پیکربندی شما حفظ می‌شود."
msgstr ""
"While the master switch is off, membership options are read-only and your configuration "
"is preserved."

msgid "تحویل حفاظت‌شده"
msgstr "Protected delivery"

msgid "تحویل حفاظت‌شده و عضویت‌های VIP"
msgstr "VIP protected delivery and memberships"

msgid "تحویل فایل"
msgstr "Delivery"

msgid "تحویل فایل حفاظت‌شده، نشانی‌های راه‌دور امضاشده و عضویت طرح‌های ووکامرس — همه با رد امن پیش‌فرض و بررسی مجوز دسترسی."
msgstr ""
"Protected file delivery, signed remote URLs, and WooCommerce plan memberships — all "
"fail-closed and entitlement-aware."

msgid "تحویل — ذخیره‌سازی محلی حفاظت‌شده یا میزبان HTTPS امضاشدهٔ راه‌دور، به‌همراه شتاب‌دهی سرور."
msgstr ""
"Delivery — local protected storage or a remote signed HTTPS host, plus server acceleration."

msgid "تنظیمات MusicWave VIP"
msgstr "MusicWave VIP settings"

msgid "تنظیمات VIP"
msgstr "VIP settings"

msgid "تنظیمات مرتبط"
msgstr "Related settings"

msgid "تنظیمات ووکامرس"
msgstr "WooCommerce settings"

msgid "تنظیمات پاک‌سازی و اعتبارسنجی می‌شوند؛ رازهای ضعیف یا مسیرهای نادرست هشدار نشان می‌دهند و مقدار قبلی را حفظ می‌کنند."
msgstr ""
"Settings are sanitized and validated; weak secrets or bad paths will show a warning "
"and keep the previous value."

msgid "ثانیه (۳۰ تا ۹۰۰)"
msgstr "seconds (30–900)"

msgid "حالت تحویل امن: ثبت‌نام اختیاری است. هر بازدیدکننده می‌تواند پخش و دانلود کند، اما پیوندها امضاشده، کوتاه‌عمر و دارای محدودیت نرخ باقی می‌مانند. آن را با یک میزبان راه‌دور امضاشده ترکیب کنید تا بدون فروش عضویت در این سایت، ساختار «فقط میزبان دانلود» داشته باشید."
msgstr ""
"Secure-delivery mode: registration is optional. Every visitor may stream and download,"
" but links stay signed, short-lived, and rate-limited. Combine with a remote signed "
"host to run a “download host only” setup without selling memberships on this site."

msgid "حالت تغییرمسیر راه‌دور هم به نشانی پایهٔ HTTPS و هم به راز امضا نیاز دارد. تا پیکربندی هر دو، تحویل با رد امن پیش‌فرض باقی می‌ماند."
msgstr ""
"Remote redirect mode needs both an HTTPS base URL and a signing secret. Delivery remains "
"fail-closed until both are configured."

msgid "حالت دسترسی هر انتشار و سطح‌های عضویت"
msgstr "Per-release access mode & membership levels"

msgid "حالت محلی فایل‌ها را خارج از ریشهٔ عمومی وب نگه می‌دارد و با PHP یا شتاب‌دهی سرور (X-Sendfile / X-Accel) پخش می‌کند. حالت تغییرمسیر راه‌دور، نشانی‌های کوتاه‌عمر HTTPS با HMAC برای S3، R2، CDN یا میزبان امضاشدهٔ خودتان می‌سازد."
msgstr ""
"Local mode keeps files outside the public web root and streams them via PHP or server "
"acceleration (X-Sendfile / X-Accel). Remote redirect mode creates short-lived HTTPS "
"HMAC URLs for S3, R2, CDN or your own signed host."

msgid "حالت محلی هرگز رازها را در معرض مرورگر نمی‌گذارد. حالت راه‌دور یک نشانی کوتاه‌عمر را امضا می‌کند (HMAC-SHA256) و تغییرمسیر می‌دهد."
msgstr ""
"Local never exposes secrets to the browser. Remote signs a short-lived URL (HMAC-SHA256) "
"and redirects."

msgid "حذف نگاشت"
msgstr "Remove mapping"

msgid "حذف نگاشت، اعطای بعدی آن سطح را متوقف می‌کند؛ کاربرانی که قبلاً مجوز گرفته‌اند تا انقضا یا لغو آن دسترسی را حفظ می‌کنند. برای تغییر قیمت، محصول را مستقیماً در ووکامرس ویرایش کنید."
msgstr ""
"Removing a mapping stops future grants for that level; already-granted users keep "
"their access until it expires or is revoked. Edit a product directly in WooCommerce "
"to change its price."

msgid "در حال حاضر %d طرح فعال پیکربندی‌شده است."
msgstr "%d plan(s) currently configured and active."

msgid "در نصب‌های زیرپوشه‌ای، مقدار خودکار کنار وردپرس رد می‌شود چون همچنان از وب قابل دسترسی است. یک مسیر مطلق خارج از ریشهٔ اسناد سرور تنظیم کنید (مثلاً /var/private/musicwave) و فایل‌های موجود را به آنجا منتقل کنید."
msgstr ""
"On subdirectory installations the automatic default beside WordPress is refused because "
"it is still web-reachable. Configure an absolute path outside the server document "
"root (for example /var/private/musicwave) and move existing files there."

msgid "در هر خط یک طرح. قالب برای جلوگیری از پیکربندی نادرست سخت‌گیرانه است."
msgstr "One plan per line. Format is strict to prevent misconfiguration."

msgid "در هر خط یک میزبان. میزبان نشانی پایهٔ راه‌دور همیشه مجاز است؛ تغییرمسیر به هر میزبان دیگری رد می‌شود."
msgstr ""
"One host per line. The remote base URL host is always allowed; redirects to any other "
"host are refused."

msgid "در ووکامرس → محصولات، یک محصول ایجاد یا ویرایش کنید (مثلاً «VIP Gold — سالانه»)."
msgstr "Create/edit a Product in WooCommerce → Products (e.g., “VIP Gold — Yearly”)."

msgid "دست‌کم ۳۲ نویسهٔ تصادفی؛ در سمت سرور ذخیره می‌شود و هرگز به مرورگر فرستاده نمی‌شود. با این دستور بسازید:"
msgstr ""
"At least 32 random characters. Stored server-side, never sent to the browser. Generate "
"with:"

msgid "ذخیرهٔ تنظیمات VIP"
msgstr "Save VIP settings"

msgid "ذخیره‌سازی محلی حفاظت‌شده، میزبان دانلود HTTPS امضاشده، نقش‌های وردپرس، افزونه‌های عضویت و اشتراک‌های ووکامرس را به هم متصل می‌کند."
msgstr ""
"Connect local protected storage, an HTTPS signed download host, WordPress roles, membership "
"extensions, and WooCommerce subscriptions."

msgid "راز امضای راه‌دور"
msgstr "Remote signing secret"

msgid "راز امضای راه‌دور کوتاه‌تر از ۳۲ نویسه است. تا ذخیرهٔ راز قوی‌تر، نشانی امضاشده صادر نمی‌شود."
msgstr ""
"The remote signing secret is shorter than 32 characters. Signed URLs will not be issued "
"until a stronger secret is saved."

msgid "راز ذخیره‌شده — برای حفظ آن خالی بگذارید"
msgstr "Stored secret — leave blank to keep"

msgid "رازهای راه‌دور هرگز در معرض مرورگر قرار نمی‌گیرند؛ فقط نشانی‌های کوتاه‌عمر امضاشده تغییرمسیر داده می‌شوند (با Referrer-Policy: no-referrer)."
msgstr ""
"Remote secrets are never exposed to the browser; only short-lived signed URLs are "
"redirected (with Referrer-Policy: no-referrer)."

msgid "راهنما و عیب‌یابی"
msgstr "Help & diagnostics"

msgid "راهنمای شروع:"
msgstr "Beginner guide:"

msgid "راه‌اندازی و عیب‌یابی"
msgstr "Setup & diagnostics"

msgid "راه‌دورِ امضاشده"
msgstr "Remote signed"

msgid "رمز فعلی کوتاه است (کمتر از ۳۲ نویسه). تا ذخیرهٔ رمز قوی‌تر، نشانی امضاشده صادر نمی‌شود."
msgstr ""
"Current secret is too short (<32 chars). Signed URLs will not be issued until you "
"save a stronger secret."

msgid "روشن: سطح‌های عضویت، خرید طرح و قوانین انقضا اعمال می‌شوند. خاموش: همهٔ محتوای مشروط به عضویت برای همه رایگان می‌شود و تحویل امن ادامه پیدا می‌کند — درست مانند برداشتن paywall برای یک تبلیغ. خریدهای ووکامرس برای هر انتشار هرگز تحت تأثیر این کلید نیستند."
msgstr ""
"On: membership levels, plan purchases, and expiry rules are enforced. Off: all membership-gated "
"content becomes free for everyone while secure delivery keeps working — exactly as "
"if the paywall was lifted for a promotion. WooCommerce per-release purchases are never "
"touched by this switch."

msgid "ساده: یک نقش WP را به‌عنوان سطح اختصاص دهید. نمونه: subscriber."
msgstr "Simple: assign a WP role as level. Example: subscriber."

msgid "سخت‌سازی Nginx / Apache (اطلاعات)"
msgstr "Nginx / Apache hardening (info)"

msgid "سطح"
msgstr "Level"

msgid "سلامت سایت"
msgstr "Site Health"

msgid "سه محصول مجازی ووکامرس را ایجاد و به‌عنوان طرح VIP نگاشت می‌کند. فشردن چندبارهٔ آن بی‌خطر است؛ نگاشت‌های موجود حفظ می‌شوند. بعداً قیمت هر محصول را در ووکامرس تعیین کنید."
msgstr ""
"Creates three virtual WooCommerce products and maps them as VIP plans. Safe to press "
"repeatedly — existing mappings are kept. Set each product price afterwards in WooCommerce."

msgid "شتاب‌دهی سرور"
msgstr "Server acceleration"

msgid "شناسه"
msgstr "ID"

msgid "شناسه را در فیلد طرح پایین وارد کنید. اگر یک سطح چند محصول می‌پذیرد، شناسه‌ها را با کاما جدا کنید."
msgstr ""
"Copy an ID into the plan field below. Use comma-separated IDs if one level accepts "
"multiple products."

msgid "شناسهٔ چرخش اختیاری که با kid= افزوده می‌شود — به میزبان راه‌دور اجازه می‌دهد بدون قطعی ابتدا راز جدید و سپس راز قدیمی را امتحان کند."
msgstr ""
"Optional rotation identifier appended as kid= — lets the remote host try the new secret "
"then the old without downtime."

msgid "شناسهٔ کلید امضا"
msgstr "Signing key ID"

msgid "شناسه‌های محصول، شناسهٔ محصولات ووکامرس هستند. مدت به‌روز است (۱ تا ۳۶۵۰)؛ برای مادام‌العمر خالی بگذارید."
msgstr ""
"Product IDs are WooCommerce product IDs. Duration is in days (1–3650); omit for lifetime."

msgid "طرح عضویت VIP MusicWave. خرید این طرح سطح عضویت منطبق را برای مدت طرح فوراً اعطا می‌کند؛ بازپرداخت یا لغو، آن را بلافاصله پس می‌گیرد."
msgstr ""
"MusicWave VIP membership plan. Purchasing this plan instantly grants the matching "
"membership level for the plan duration; refunds or cancellations revoke it immediately."

msgid "طرح‌های زمان‌دار با cron ساعتی و هنگام ورود خودکار منقضی می‌شوند؛ پاک‌سازی دستی لازم نیست."
msgstr "Timed plans auto-expire via hourly cron and on login; no manual cleanup needed."

