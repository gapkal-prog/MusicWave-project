msgstr "Local protected directory (recommended)"

msgid "پوشهٔ فایل‌های حفاظت‌شده"
msgstr "Protected files directory"

msgid "پیام‌های دسترسی و مسیر جایگزین عضویت (هسته)"
msgstr "Access messages & membership fallback (Core)"

