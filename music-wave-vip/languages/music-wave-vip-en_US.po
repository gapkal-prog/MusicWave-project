msgstr "No plan mappings yet. Use the button above or add lines in the mapping box below."

msgid "هیچ‌کدام = PHP فایل را می‌خواند و پخش می‌کند (ساده‌تر، اما برای FLAC/ZIP بزرگ کندتر). X-Sendfile/X-Accel را فقط وقتی انتخاب کنید که میزبان شما آن را فعال کرده باشد."
msgstr ""
"None = PHP reads and streams (simple, slower for large FLAC/ZIP). Choose X-Sendfile/X-Accel "
"only if your host has it enabled."

msgid "وب‌سرور می‌تواند بارگذاری‌ها را در پوشهٔ حفاظت‌شده بنویسد."
msgstr "The web server can write uploads into the protected directory."

msgid "وب‌سرور می‌تواند پوشهٔ حفاظت‌شده را بخواند."
msgstr "The web server can read the protected directory."

msgid "وضعیت"
