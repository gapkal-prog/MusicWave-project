{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "musicwave/release-slider",
  "title": "MusicWave release slider",
  "category": "theme",
  "description": "A responsive, accessible slider for featured or recent releases. Fully customizable via Site Editor and global slider settings.",
  "keywords": ["slider", "carousel", "releases", "featured", "music"],
  "textdomain": "musicwave",
  "icon": "slides",
  "attributes": {
    "enabled": { "type": "string", "default": "inherit" },
    "eyebrow": { "type": "string", "default": "" },
    "title": { "type": "string", "default": "" },
    "orderBy": { "type": "string", "default": "date" },
    "order": { "type": "string", "default": "DESC" },
    "taxonomy": { "type": "string", "default": "" },
    "termSlug": { "type": "string", "default": "" },
    "releaseIds": { "type": "string", "default": "" },
    "contentType": { "type": "string", "default": "" },
    "itemsToShow": { "type": "integer", "default": 0 },
    "autoplay": { "type": "string", "default": "inherit" },
    "interval": { "type": "integer", "default": 0 },
    "loop": { "type": "string", "default": "inherit" },
    "pauseOnHover": { "type": "string", "default": "inherit" },
    "showArrows": { "type": "string", "default": "inherit" },
    "showDots": { "type": "string", "default": "inherit" },
    "showExcerpt": { "type": "boolean", "default": false },
    "showArtist": { "type": "boolean", "default": true },
    "showDate": { "type": "boolean", "default": false },
    "showViews": { "type": "boolean", "default": false }
  },
  "supports": {
    "align": ["wide", "full"],
    "anchor": true,
    "color": { "background": true, "text": true, "gradient": true, "link": true },
    "spacing": { "margin": true, "padding": true, "blockGap": true },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "dimensions": { "minHeight": true },
    "typography": { "fontSize": true, "lineHeight": true },
    "shadow": true,
    "interactivity": false
  },
  "example": {
    "attributes": {
      "eyebrow": "Made for you",
      "title": "Featured releases",
      "itemsToShow": 6
    }
  }
}
