{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "title": "Aurora",
  "settings": {
    "color": {
      "palette": [
        { "slug": "canvas", "name": "Canvas", "color": "#0c1020" },
        { "slug": "surface", "name": "Surface", "color": "#151b33" },
        { "slug": "surface-raised", "name": "Raised surface", "color": "#202a4b" },
        { "slug": "text", "name": "Text", "color": "#eef3ff" },
        { "slug": "muted", "name": "Muted text", "color": "#aebbd8" },
        { "slug": "accent", "name": "Accent", "color": "#28d7bd" },
        { "slug": "accent-strong", "name": "Accent strong", "color": "#7cf4df" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system"
    },
    "elements": {
      "button": {
        "border": { "radius": "0.75rem" },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|canvas"
        }
      },
      "link": {
        "color": { "text": "var:preset|color|accent-strong" }
      }
    }
  }
}
