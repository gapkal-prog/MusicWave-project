{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Cassette",
  "settings": {
    "custom": {
      "scheme": {
        "light": { "canvas": "#f6f0e6", "surface": "#fffaf2", "surfaceRaised": "#eadcc8", "text": "#2a211d", "muted": "#75645b", "accent": "#bd3f32", "accentStrong": "#8d2b24", "editorial": "#b91c1c", "onAccent": "#fff7ed" },
        "dark": { "canvas": "#1a1412", "surface": "#241c18", "surfaceRaised": "#332822", "text": "#f6efe6", "muted": "#b8a99c", "accent": "#e0674f", "accentStrong": "#f08a74", "editorial": "#f87171", "onAccent": "#2a120d" }
      }
    },
    "color": {
      "palette": [
        { "slug": "canvas", "name": "Canvas", "color": "#f6f0e6" },
        { "slug": "surface", "name": "Surface", "color": "#fffaf2" },
        { "slug": "surface-raised", "name": "Raised surface", "color": "#eadcc8" },
        { "slug": "text", "name": "Text", "color": "#2a211d" },
        { "slug": "muted", "name": "Muted text", "color": "#75645b" },
        { "slug": "accent", "name": "Accent", "color": "#bd3f32" },
        { "slug": "accent-strong", "name": "Accent strong", "color": "#8d2b24" },
        { "slug": "editorial", "name": "Editorial rose", "color": "#b91c1c" },
        { "slug": "on-accent", "name": "On accent", "color": "#fff7ed" }
      ],
      "gradients": [
        { "slug": "accent-wash", "name": "Accent wash", "gradient": "radial-gradient(circle at 16% 18%, rgba(189,63,50,0.18), transparent 56%), linear-gradient(180deg, #fffaf2, #f6f0e6)" },
        { "slug": "editorial-rose", "name": "Editorial rose", "gradient": "linear-gradient(135deg, #bd3f32, #7a2d12 55%, #3e1a0a)" }
      ]
    },
    "shadow": {
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 14px 36px rgb(60 40 20 / 14%)" },
        { "slug": "floating", "name": "Floating", "shadow": "0 22px 56px rgb(60 40 20 / 18%)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|serif"
    },
    "elements": {
      "button": {
        "border": { "radius": "0.35rem" },
        "color": { "background": "var:preset|color|accent", "text": "var:preset|color|on-accent" },
        "typography": { "fontWeight": "700" }
      },
      "heading": { "typography": { "fontFamily": "var:preset|font-family|serif", "fontWeight": "700", "letterSpacing": "-0.015em" } },
      "link": { "color": { "text": "var:preset|color|accent-strong" } }
    }
  }
}
