{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "SonicStream",
  "settings": {
    "color": {
      "palette": [
        { "slug": "canvas", "name": "Canvas", "color": "#0a0a0a" },
        { "slug": "surface", "name": "Surface", "color": "#181818" },
        { "slug": "surface-raised", "name": "Raised surface", "color": "#282828" },
        { "slug": "text", "name": "Text", "color": "#ffffff" },
        { "slug": "muted", "name": "Muted text", "color": "#a7a7a7" },
        { "slug": "accent", "name": "Accent", "color": "#1db954" },
        { "slug": "accent-strong", "name": "Accent strong", "color": "#1ed760" },
        { "slug": "editorial", "name": "Editorial rose", "color": "#fa2d48" },
        { "slug": "on-accent", "name": "On accent", "color": "#000000" }
      ],
      "gradients": [
        { "slug": "accent-wash", "name": "Accent wash", "gradient": "radial-gradient(circle at 15% 20%, rgba(29,185,84,0.35), transparent 55%), linear-gradient(180deg, #232b26, #0a0a0a)" },
        { "slug": "accent-button", "name": "Accent button", "gradient": "linear-gradient(135deg, #1ed760, #17a34a)" },
        { "slug": "editorial-rose", "name": "Editorial rose", "gradient": "linear-gradient(135deg, #fa2d48, #a91267 55%, #341550)" }
      ]
    },
    "shadow": {
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 18px 50px rgb(0 0 0 / 24%)" },
        { "slug": "floating", "name": "Floating", "shadow": "0 24px 70px rgb(0 0 0 / 40%)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|text"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system"
    },
    "elements": {
      "button": {
        "border": { "radius": "999px" },
        "color": { "background": "var:preset|color|accent", "text": "var:preset|color|on-accent" },
        "typography": { "fontWeight": "800" }
      },
      "heading": { "typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "800", "lineHeight": "1.05", "letterSpacing": "-0.02em" } },
      "link": { "color": { "text": "var:preset|color|accent-strong" } }
    }
  }
}
