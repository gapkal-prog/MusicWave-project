{
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "border": {
      "radius": true
    },
    "shadow": {
      "presets": [
        {
          "slug": "card",
          "name": "Card",
          "shadow": "0 18px 50px rgb(0 0 0 / 24%)"
        },
        {
          "slug": "floating",
          "name": "Floating player",
          "shadow": "0 24px 70px rgb(0 0 0 / 40%)"
        }
      ]
    },
    "color": {
      "defaultDuotone": false,
      "defaultGradients": true,
      "defaultPalette": false,
      "gradients": [
        {
          "slug": "accent-wash",
          "name": "Accent wash",
          "gradient": "radial-gradient(circle at 15% 20%, rgba(29,185,84,0.35), transparent 55%), linear-gradient(180deg, #283040, #0b0d12)"
        },
        {
          "slug": "accent-button",
          "name": "Accent button",
          "gradient": "linear-gradient(135deg, #1ed760, #17a34a)"
        },
        {
          "slug": "editorial-rose",
          "name": "Editorial rose",
          "gradient": "linear-gradient(135deg, #fa2d48, #a91267 55%, #341550)"
        },
        {
          "slug": "midnight-radio",
          "name": "Midnight radio",
          "gradient": "radial-gradient(circle at 75% 15%, rgba(124,58,237,0.55), transparent 42%), linear-gradient(145deg, #1f2937, #08090d)"
        }
      ],
      "palette": [
        { "slug": "canvas", "name": "Canvas", "color": "#090a0f" },
        { "slug": "surface", "name": "Surface", "color": "#15171e" },
        { "slug": "surface-raised", "name": "Raised surface", "color": "#222631" },
        { "slug": "text", "name": "Text", "color": "#f7f8fb" },
        { "slug": "muted", "name": "Muted text", "color": "#a9b0c0" },
        { "slug": "accent", "name": "Accent", "color": "#1db954" },
        { "slug": "accent-strong", "name": "Accent strong", "color": "#1ed760" },
        { "slug": "editorial", "name": "Editorial rose", "color": "#fa2d48" },
        { "slug": "on-accent", "name": "On accent", "color": "#052e16" }
      ]
    },
    "spacing": {
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "size": "clamp(0.75rem, 0.7rem + 0.25vw, 1rem)", "name": "Small" },
        { "slug": "30", "size": "clamp(1rem, 0.85rem + 0.7vw, 1.5rem)", "name": "Medium" },
        { "slug": "40", "size": "clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem)", "name": "Large" },
        { "slug": "50", "size": "clamp(2.5rem, 1.8rem + 3vw, 5rem)", "name": "X Large" }
      ],
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "fluid": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Arial, sans-serif"
        },
        {
          "slug": "serif",
          "name": "Editorial Serif",
          "fontFamily": "Iowan Old Style, Baskerville, 'Times New Roman', serif"
        },
        {
          "slug": "mono",
          "name": "Studio Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "clamp(1.25rem, 1.1rem + 0.7vw, 1.75rem)", "name": "Large" },
        { "slug": "x-large", "size": "clamp(2rem, 1.4rem + 2.8vw, 4.5rem)", "name": "Display" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|canvas",
      "text": "var:preset|color|text"
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|30",
        "right": "var:preset|spacing|30"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": { "radius": "999px" },
        "color": { "background": "var:preset|color|accent", "text": "var:preset|color|on-accent" },
        "spacing": { "padding": { "top": "0.75rem", "right": "1.5rem", "bottom": "0.75rem", "left": "1.5rem" } },
        "typography": { "fontWeight": "700" },
        ":hover": {
          "color": { "background": "var:preset|color|accent-strong", "text": "var:preset|color|on-accent" }
        }
      },
      "heading": { "typography": { "fontWeight": "750", "lineHeight": "1.15", "letterSpacing": "-0.02em" } },
      "link": { "color": { "text": "var:preset|color|accent-strong" } }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontWeight": "600" } },
      "core/search": { "border": { "radius": "999px" } },
      "core/post-featured-image": { "border": { "radius": "1rem" } },
      "core/post-template": { "spacing": { "blockGap": "var:preset|spacing|30" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    {
      "name": "page-no-sidebar",
      "title": "Page (no sidebar)",
      "postTypes": ["page"]
    },
    {
      "name": "page-account",
      "title": "Music account",
      "postTypes": ["page"]
    },
    {
      "name": "page-music-home",
      "title": "Music editorial home",
      "postTypes": ["page"]
    },
    {
      "name": "page-browse",
      "title": "Browse music",
      "postTypes": ["page"]
    }
  ]
}
